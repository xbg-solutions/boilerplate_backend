{
  "name": "@xbg.solutions/boilerplate-backend",
  "version": "3.0.0",
  "private": true,
  "description": "XBG Backend Boilerplate - Monorepo",
  "workspaces": [
    "packages/utils-*",
    "packages/create-backend",
    "packages/core"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "mirror:sync": "node scripts/sync-mirror.js",
    "mirror:check": "node scripts/check-mirror.js",
    "test": "npm run mirror:check && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --config jest.coverage.config.js --coverage",
    "lint": "eslint .",
    "clean": "npm run clean --workspaces --if-present",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^10.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript-eslint": "^8.67.0"
  }
}
