{
  "name": "@xbg.solutions/boilerplate-backend",
  "version": "3.0.0",
  "private": true,
  "description": "XBG Backend Boilerplate - Monorepo",
  "workspaces": [
    "packages/utils-*",
    "packages/create-backend",
    "packages/core"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "mirror:sync": "node scripts/sync-mirror.js",
    "mirror:check": "node scripts/check-mirror.js",
    "test": "npm run mirror:check && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --config jest.coverage.config.js --coverage",
    "lint": "eslint .",
    "clean": "npm run clean --workspaces --if-present",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^10.9.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "axios": "^1.20.0",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "brace-expansion": "^2.1.7",
    "decode-uri-component": "0.5.0",
    "query-string": "^9.3.0",
    "@grpc/grpc-js": "^1.14.5",
    "qs": "^6.16.0",
    "body-parser": "^1.20.8",
    "js-yaml": "^3.15.2",
    "uuid": "^11.1.1",
    "browserslist": "^4.29.3",
    "baseline-browser-mapping": "^2.11.27",
    "csv-parse": "^7.0.3",
    "@fastify/busboy": "^3.2.2"
  }
}
