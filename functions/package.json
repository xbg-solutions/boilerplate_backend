{
  "name": "backend-boilerplate-functions",
  "version": "2.0.1",
  "description": "Production-ready backend boilerplate with code generation capabilities",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate": "node ../__scripts__/generate.js",
    "setup": "node ../__scripts__/setup.js",
    "deploy:full": "node ../__scripts__/deploy.js",
    "validate": "node ../__scripts__/validate.js",
    "validate:quick": "node ../__scripts__/validate.js --skip-tests --skip-build"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.3.42",
    "@hubspot/api-client": "^9.0.0",
    "@notionhq/client": "^2.2.14",
    "cors": "^2.8.5",
    "countries-and-timezones": "^3.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "handlebars": "^4.7.10",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.13.9",
    "jsforce": "^3.10.13",
    "lodash": "^4.17.21",
    "messagebird": "^4.0.0",
    "node-mailjet": "^6.0.5",
    "twilio": "^4.19.0",
    "uuid": "^11.1.1",
    "ws": "^8.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "axios": "^1.21.1",
    "body-parser": "^1.20.9",
    "proxy-addr": "^2.0.8",
    "undici": "^8.12.4",
    "follow-redirects": "^1.16.3",
    "decode-uri-component": "^0.5.1",
    "qs": "^6.17.1",
    "tough-cookie": "^4.1.3",
    "brace-expansion@<=1.1.20": "1.1.21",
    "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
    "brace-expansion@>=4.0.0 <5.0.12": "5.0.13"
  },
  "private": true
}
