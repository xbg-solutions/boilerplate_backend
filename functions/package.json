{
  "name": "backend-boilerplate-functions",
  "version": "2.0.1",
  "description": "Production-ready backend boilerplate with code generation capabilities",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate": "node ../__scripts__/generate.js",
    "setup": "node ../__scripts__/setup.js",
    "deploy:full": "node ../__scripts__/deploy.js",
    "validate": "node ../__scripts__/validate.js",
    "validate:quick": "node ../__scripts__/validate.js --skip-tests --skip-build"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.3.42",
    "@hubspot/api-client": "^9.0.0",
    "@notionhq/client": "^2.2.14",
    "cors": "^2.8.5",
    "countries-and-timezones": "^3.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.3.2",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.13.8",
    "jsforce": "^3.10.28",
    "lodash": "^4.17.21",
    "messagebird": "^4.0.0",
    "node-mailjet": "^6.0.5",
    "twilio": "^4.19.0",
    "uuid": "^11.1.1",
    "ws": "^8.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "axios": "^1.20.0",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "brace-expansion": "^2.1.7",
    "decode-uri-component": "^0.5.0",
    "@grpc/grpc-js": "^1.14.5",
    "qs": "^6.16.0",
    "body-parser": "^1.20.8",
    "js-yaml": "^3.15.2",
    "uuid": "^11.1.1",
    "browserslist": "^4.29.3",
    "baseline-browser-mapping": "^2.11.27",
    "csv-parse": "^7.0.3",
    "@fastify/busboy": "^3.2.2"
  },
  "private": true
}
